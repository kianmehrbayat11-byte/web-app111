{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app111",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "24f8f933-a9a5-47a1-8613-b83dc4d7bbac","database_name": "webapp" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "098802a68bb6457a9cba1cedca0e938d" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
